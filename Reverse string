#include <iostream>
#include <string>
using namespace std;
void reverseString(string s, int n) {
    if (n < 0) return;
    cout << s[n];
    reverseString(s, n - 1);
}
int main() {
    string str;
    cout << "Enter a string: ";
    cin >> str;
    cout << "Reverse: ";
    reverseString(str, str.length() - 1);
    cout << endl;
    return 0;
}

